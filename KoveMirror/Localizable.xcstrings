    "Choose 'Open Kove Mirror' from Shortcuts or 'Open App → Kove Mirror'. The app will launch and connect automatically.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle 'Kove Mirror öffnen' aus Kurzbefehle oder 'App öffnen → Kove Mirror'. Die App startet und verbindet sich automatisch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε 'Άνοιγμα Kove Mirror' από τις Συντομεύσεις ή 'Άνοιγμα εφαρμογής → Kove Mirror'. Η εφαρμογή θα εκκινηθεί και θα συνδεθεί αυτόματα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige 'Abrir Kove Mirror' desde Atajos o 'Abrir app → Kove Mirror'. La aplicación se iniciará y conectará automáticamente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse Pikakomennoista 'Avaa Kove Mirror' tai 'Avaa appi → Kove Mirror'. Sovellus käynnistyy ja muodostaa yhteyden automaattisesti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli 'Apri Kove Mirror' da Comandi Rapidi o 'Apri app → Kove Mirror'. L'app si avvierà e si connetterà automaticamente."
          }
        }
      }
    },
    "Choose Bluetooth, select your bike's device (e.g. CQKY-... or KOVE-...), and select 'Run Immediately'.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Bluetooth, wähle das Gerät deines Motorrads (z. B. CQKY-... oder KOVE-...) und wähle 'Sofort ausführen'."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε Bluetooth, επιλέξτε τη συσκευή της μοτοσυκλέτας σας (π.χ. CQKY-... ή KOVE-...) και επιλέξτε 'Άμεση εκτέλεση'."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige Bluetooth, selecciona el dispositivo de tu moto (ej. CQKY-... o KOVE-...) y marca 'Ejecutar inmediatamente'."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse Bluetooth, valitse moottoripyöräsi laite (esim. CQKY-... tai KOVE-...) ja valitse 'Suorita heti'."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli Bluetooth, seleziona il dispositivo della tua moto (es. CQKY-... o KOVE-...) e seleziona 'Esegui immediatamente'."
          }
        }
      }
    },
    "Choose your motorcycle's Bluetooth device (e.g. CQKY-... or KOVE-...) and select 'Run Immediately'.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle das Bluetooth-Gerät deines Motorrads (z. B. CQKY-... oder KOVE-...) und wähle 'Sofort ausführen'."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε τη συσκευή Bluetooth της μοτοσυκλέτας σας (π.χ. CQKY-... ή KOVE-...) και επιλέξτε 'Άμεση εκτέλεση'."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona el dispositivo Bluetooth de tu moto (ej. CQKY-... o KOVE-...) y selecciona 'Ejecutar inmediatamente'."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse moottoripyöräsi Bluetooth-laite (esim. CQKY-... tai KOVE-...) ja valitse 'Suorita heti'."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli il dispositivo Bluetooth della tua moto (es. CQKY-... o KOVE-...) e seleziona 'Esegui immediatamente'."
          }
        }
      }
    },
