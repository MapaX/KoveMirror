            "value": "ENT"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ENT"
          }
        }
      }
    },
    "Establishes a low-power connection with the motorcycle's dashboard, performs the pairing handshake, and transmits continuous heartbeats to keep the system active.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt eine energiesparende Verbindung mit dem Armaturenbrett des Motorrads her, führt den Kopplungshandshake durch und überträgt kontinuierlich Heartbeats, um das System aktiv zu halten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιουργεί μια σύνδεση χαμηλής κατανάλωσης με τον πίνακα οργάνων της μοτοσυκλέτας, εκτελεί τη χειραψία ζεύξης και μεταδίδει συνεχείς παλμούς για να διατηρεί το σύστημα ενεργό."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establece una conexión de bajo consumo con el panel de la motocicleta, realiza el protocolo de emparejamiento y transmite señales continuas para mantener el sistema activo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muodostaa vähävirtaisen yhteyden moottoripyörän mittaristoon, suorittaa pariliitoksen ja lähettää jatkuvia syötteitä pitääkseen järjestelmän aktiivisena."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabilisce una connessione a basso consumo con il cruscotto della moto, esegue l'accoppiamento e invia segnali periodici per mantenere il sistema attivo."
          }
        }
      }
    },
