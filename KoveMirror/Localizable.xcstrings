    "No log events match your query.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Protokollereignisse entsprechen deiner Suchanfrage."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν βρέθηκαν συμβάντα καταγραφής που να ταιριάζουν με το ερώτημά σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
