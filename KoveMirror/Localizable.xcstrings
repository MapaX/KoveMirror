        }
      }
    },
    "About Kove Mirror" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über Kove Mirror"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σχετικά με το Kove Mirror"
          }
        },
        "es" : {
