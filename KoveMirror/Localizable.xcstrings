    "Streams your map or phone screen to the motorcycle TFT display using Apple's hardware H.264 encoder at native resolution.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überträgt deine Karte oder den Telefonbildschirm mit Apples Hardware-H.264-Encoder in nativer Auflösung auf das TFT-Display des Motorrads."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μεταδίδει τον χάρτη ή την οθόνη του τηλεφώνου σας στην οθόνη TFT της μοτοσυκλέτας χρησιμοποιώντας τον κωδικοποιητή υλικού H.264 της Apple σε εγγενή ανάλυση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transmite el mapa o la pantalla del teléfono a la pantalla TFT de la motocicleta mediante el codificador por hardware H.264 de Apple a resolución nativa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suoratoistaa kartan tai puhelimen näytön moottoripyörän TFT-näytölle käyttäen Applen laitteistopohjaista H.264-kooderia natiiviresoluutiolla."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasmette la mappa o lo schermo del telefono al display TFT della moto utilizzando l'encoder hardware H.264 di Apple alla risoluzione nativa."
          }
        }
      }
    },
    "Tap + and select Bluetooth as the trigger.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf + und wähle Bluetooth als Auslöser."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
