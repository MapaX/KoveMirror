    "Open the Apple Shortcuts app, switch to the Automation tab, and tap + to create a new automation.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die Apple Kurzbefehle-App, wechsle zum Tab Automation und tippe auf +, um eine neue Automation zu erstellen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε την εφαρμογή Συντομεύσεις της Apple, μεταβείτε στην καρτέλα Αυτοματισμός και πατήστε + για να δημιουργήσετε έναν νέο αυτοματισμό."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la app Atajos de Apple, ve a la pestaña Automatización y toca + para crear una nueva automatización."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Applen Pikakomennot-appi, siirry Automaatio-välilehdelle ja luo uusi automaatio napauttamalla +."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri l'app Comandi Rapidi di Apple, passa alla scheda Automazione e tocca + per creare una nuova automazione."
          }
        }
      }
    },
    "Open the iOS Shortcuts app and select the Automation tab.": {
      "localizations": {
        "de": {
