    "No log file available. Enable file logging above to generate logs.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Protokolldatei verfügbar. Aktiviere oben die Dateiprotokollierung, um Protokolle zu erstellen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει διαθέσιμο αρχείο καταγραφής. Ενεργοποιήστε την καταγραφή αρχείου παραπάνω για να δημιουργήσετε αρχεία καταγραφής."
          }
        },
        "es": {
