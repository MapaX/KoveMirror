    "Align the Motorcycle's QR code in the frame" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richte den QR-Code des Motorrads im Rahmen aus"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ευθυγραμμίστε τον κωδικό QR της μοτοσυκλέτας στο πλαίσιο"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alinea el código QR de la motocicleta en el marco"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aseta moottoripyörän QR-koodi kehykseen"
          }
        }
      }
    },
    "Automatically streams the in-app dashboard views. When you broadcast the entire screen, it seamlessly switches to the broadcast stream, falling back dynamically on exit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überträgt automatisch die Ansichten des In-App-Dashboards. Wenn du den gesamten Bildschirm überträgst, wird nahtlos zum Übertragungsstream gewechselt und beim Beenden dynamisch zurückgekehrt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μεταδίδει αυτόματα τις προβολές του πίνακα οργάνων της εφαρμογής. Όταν μεταδίδετε ολόκληρη την οθόνη, μεταβαίνει ομαλά στη ροή μετάδοσης, επιστρέφοντας δυναμικά κατά την έξοδο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transmite automáticamente las vistas del panel dentro de la app. Al transmitir la pantalla completa, cambia sin problemas a la transmisión completa y regresa dinámicamente al salir."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Striimaa automaattisesti sovelluksen sisäisiä näkymiä. Kun peilaat koko näytön, se siirtyy saumattomasti järjestelmäpeilaukseen ja palaa takaisin poistuttaessa."
          }
        }
      }
    },
