    },
    "Launches local TCP/UDP socket servers. The motorcycle dashboard connects to your iPhone's hotspot or Wi-Fi to receive the high-fidelity video stream." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startet lokale TCP/UDP-Socket-Server. Das Motorrad-Armaturenbrett verbindet sich mit dem Hotspot oder Wi-Fi deines iPhones, um den hochauflösenden Videostream zu empfangen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εκκινεί τοπικούς διακομιστές υποδοχών TCP/UDP. Ο πίνακας οργάνων της μοτοσυκλέτας συνδέεται στο hotspot ή στο Wi-Fi του iPhone σας για να λάβει τη ροή βίντεο υψηλής πιστότητας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia servidores de socket TCP/UDP locales. El panel de la motocicleta se conecta al punto de acceso o Wi-Fi de tu iPhone para recibir la transmisión de video de alta fidelidad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käynnistää paikalliset TCP/UDP-palvelimet. Moottoripyörän mittaristo yhdistää iPhonen yhteyspisteeseen tai Wi-Fi-verkkoon vastaanottaakseen korkealaatuisen kuvasyötteen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvia server socket TCP/UDP locali. Il cruscotto della moto si connette all'hotspot o al Wi-Fi del tuo iPhone per ricevere il flusso video ad alta fedeltà."
          }
        }
      }
    },
