    "Add Open App Action": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktion 'App öffnen' hinzufügen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθήκη ενέργειας άνοιγμα εφαρμογής"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir acción 'Abrir app'"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää Avaa appi -toiminto"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi azione 'Apri app'"
          }
        }
      }
    },
    "Add the action 'Open Kove Mirror' or 'Open App → Kove Mirror'.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge die Aktion 'Kove Mirror öffnen' oder 'App öffnen → Kove Mirror' hinzu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε την ενέργεια 'Άνοιγμα Kove Mirror' ή 'Άνοιγμα εφαρμογής → Kove Mirror'."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade la acción 'Abrir Kove Mirror' o 'Abrir app → Kove Mirror'."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää toiminto 'Avaa Kove Mirror' tai 'Avaa appi → Kove Mirror'."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi l'azione 'Apri Kove Mirror' o 'Apri app → Kove Mirror'."
          }
        }
      }
    },
    "Adds black letterbox margins at the top and bottom of the mirrored window to prevent motorcycle instrument panel indicators from obscuring the content.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt oben und unten am gespiegelten Fenster schwarze Ränder hinzu, damit Anzeigen der Instrumententafel den Inhalt nicht verdecken."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέτει μαύρα περιθώρια πάνω και κάτω στο παράθυρο καθρεφτισμού για να μην επικαλύπτουν οι ενδείξεις του πίνακα οργάνων το περιεχόμενο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade márgenes negros arriba y abajo de la ventana reflejada para evitar que los indicadores del panel de instrumentos oculten el contenido."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää mustat reunamarginaalit peilatun näkymän ylä- ja alaosaan, jotta mittariston merkkivalot eivät peitä sisältöä."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge margini neri superiore e inferiore alla finestra riflessa per evitare che gli indicatori del cruscotto coprano il contenuto."
          }
        }
      }
    },
    "After mirroring starts, use the \"Broadcast Entire Screen\" button to display third-party navigation apps (Google Maps, OsmAnd, etc.) on the TFT screen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende nach dem Start der Spiegelung die Schaltfläche \"Gesamten Bildschirm übertragen\", um Navigations-Apps von Drittanbietern (Google Maps, OsmAnd usw.) auf dem TFT-Bildschirm anzuzeigen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετά την έναρξη του καθρεφτισμού, χρησιμοποιήστε το κουμπί \"Μετάδοση ολόκληρης της οθόνης\" για να προβάλετε εφαρμογές πλοήγησης τρίτων (Google Maps, OsmAnd κ.λπ.) στην οθόνη TFT."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras iniciar el reflejo, usa el botón \"Transmitir pantalla completa\" para mostrar apps de navegación de terceros (Google Maps, OsmAnd, etc.) en la pantalla TFT."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun peilaus käynnistyy, käytä \"Lähetä koko näyttö\" -painiketta näyttääksesi kolmannen osapuolen navigointisovelluksia (Google Maps, OsmAnd jne.) TFT-näytöllä."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo aver avviato il mirroring, usa il pulsante \"Trasmetti l'intero schermo\" per visualizzare app di navigazione terze (Google Maps, OsmAnd, ecc.) sullo schermo TFT."
          }
        }
      }
    },
