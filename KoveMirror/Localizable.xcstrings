    "Ensure the Thinkerride app is completely closed so it releases the motorcycle's Bluetooth connection.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle sicher, dass die Thinkerride-App vollständig geschlossen ist, damit sie die Bluetooth-Verbindung des Motorrads freigibt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βεβαιωθείτε ότι η εφαρμογή Thinkerride είναι εντελώς κλειστή, ώστε να αποδεσμεύσει τη σύνδεση Bluetooth της μοτοσυκλέτας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrate de que la app Thinkerride esté completamente cerrada para liberar la conexión Bluetooth de la moto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmista, että Thinkerride-sovellus on täysin suljettu, jotta se vapauttaa moottoripyörän Bluetooth-yhteyden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assicurati che l'app Thinkerride sia completamente chiusa in modo che rilasci la connessione Bluetooth della moto."
          }
        }
      }
    },
    "ENT": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ENT"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "ENT"
          }
        },
        "es": {
