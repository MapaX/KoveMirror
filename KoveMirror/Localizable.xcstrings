    "• Screen Visible & Stream Running" : {

    },
    "1. Connect your iPhone to the motorcycle's Bluetooth network." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Verbinde dein iPhone mit dem Bluetooth-Netzwerk des Motorrads."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Συνδέστε το iPhone σας στο δίκτυο Bluetooth της μοτοσυκλέτας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Conecta tu iPhone a la red Bluetooth de la motocicleta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Yhdistä iPhone moottoripyörän Bluetooth-verkkoon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Connetti il tuo iPhone alla rete Bluetooth della moto."
          }
        }
      }
    },
    "2. Connect your iPhone to the motorcycle's Wi-Fi network." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Verbinde dein iPhone mit dem Wi-Fi-Netzwerk des Motorrads."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Συνδέστε το iPhone σας στο δίκτυο Wi-Fi της μοτοσυκλέτας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Conecta tu iPhone a la red Wi-Fi de la motocicleta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Yhdistä iPhone moottoripyörän Wi-Fi-verkkoon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Connetti il tuo iPhone alla rete Wi-Fi della moto."
          }
        }
      }
    },
    "3. Long press SET button from motorcycle handlebar, and select 'Sceen navigation'" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Halte die SET-Taste am Motorradlenker gedrückt und wähle 'Sceen navigation'"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Πιέστε παρατεταμένα το κουμπί SET στο τιμόνι της μοτοσυκλέτας και επιλέξτε 'Sceen navigation'"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Mantén presionado el botón SET en el manillar y selecciona 'Sceen navigation'"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Paina ohjaustangon SET-painiketta pitkään ja valitse 'Sceen navigation'"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Premi a lungo il pulsante SET sul manubrio della moto e seleziona 'Sceen navigation'"
          }
        }
      }
    },
    "4. Your screen will automatically project to the TFT screen." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4. Dein Bildschirm wird automatisch auf dem TFT-Bildschirm gespiegelt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4. Η οθόνη σας θα προβληθεί αυτόματα στην οθόνη TFT."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4. Tu pantalla se proyectará automáticamente en la pantalla TFT."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4. Näyttösi peilataan automaattisesti TFT-näytölle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4. Il tuo schermo verrà proiettato automaticamente sullo schermo TFT."
          }
        }
      }
    },
    "5. After the phone screen is visible, press the 'Broadcast Entire Screen' button to start whole phone mirroring." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5. Sobald der Telefonbildschirm sichtbar ist, drücke die Taste 'Gesamten Bildschirm übertragen', um die Spiegelung zu starten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5. Αφού εμφανιστεί η οθόνη του τηλεφώνου, πατήστε το κουμπί 'Μετάδοση ολόκληρης οθόνης' για να ξεκινήσει η πλήρης καθρέφτιση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5. Una vez visible la pantalla del teléfono, presiona 'Transmitir pantalla completa' para iniciar el reflejo total."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5. Kun puhelimen näyttö on näkyvissä, paina 'Peilaa koko näyttö' -painiketta aloittaaksesi koko puhelimen peilauksen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5. Quando lo schermo del telefono è visibile, premi il pulsante 'Trasmetti l'intero schermo' per avviare il mirroring completo del telefono."
          }
        }
      }
    },
