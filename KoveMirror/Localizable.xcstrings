    "Bluetooth must be turned on to connect to your motorcycle's TFT display." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth muss eingeschaltet sein, um eine Verbindung zum TFT-Display des Motorrads herzustellen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Bluetooth πρέπει να είναι ενεργοποιημένο για να συνδεθείτε στην οθόνη TFT της μοτοσυκλέτας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Bluetooth debe estar activado para conectarse a la pantalla TFT de la motocicleta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetoothin on oltava päällä moottoripyörän TFT-näyttöön yhdistämiseksi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
