      }
    },
    "Sends turn maneuvers, distance, and road names directly to the motorcycle's built-in TFT navigation display without requiring video streaming.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet Abbiegemanöver, Entfernung und Straßennamen direkt an das integrierte TFT-Navigationsdisplay des Motorrads, ohne dass Videostreaming erforderlich ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στέλνει οδηγίες στροφών, απόσταση και ονόματα δρόμων απευθείας στην ενσωματωμένη οθόνη πλοήγησης TFT της μοτοσυκλέτας χωρίς να απαιτείται ροή βίντεο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía maniobras de giro, distancia y nombres de calles directamente a la pantalla de navegación TFT integrada de la motocicleta sin requerir transmisión de video."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähettää kääntymisohjeet, etäisyyden ja teiden nimet suoraan moottoripyörän sisäänrakennetulle TFT-navigointinäytölle ilman videolähetystä."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia indicazioni di svolta, distanza e nomi delle vie direttamente al display di navigazione TFT integrato della moto senza richiedere lo streaming video."
          }
        }
      }
    },
