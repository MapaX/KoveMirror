    "Receives inputs from the motorcycle handlebar buttons (SET, navigation keys) to control playback and maps.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Empfängt Eingaben von den Lenkerschaltern des Motorrads (SET, Navigationstasten), um Wiedergabe und Karten zu steuern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λαμβάνει εντολές από τα κουμπιά τιμονιού της μοτοσυκλέτας (SET, πλήκτρα πλοήγησης) για τον έλεγχο αναπαραγωγής και χαρτών."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe entradas de los botones del manillar de la motocicleta (SET, teclas de navegación) para controlar la reproducción y los mapas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastaanottaa syötteitä moottoripyörän ohjaustangon painikkeista (SET, navigointinäppäimet) toiston ja karttojen ohjaamiseen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riceve i comandi dai pulsanti al manubrio della moto (SET, tasti di navigazione) per controllare la riproduzione e le mappe."
          }
        }
      }
    },
