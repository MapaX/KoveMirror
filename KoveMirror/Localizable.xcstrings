    "Explore the source code, file issues, or contribute to the project on GitHub." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkunde den Quellcode, melde Probleme oder trage auf GitHub zum Projekt bei."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εξερευνήστε τον πηγαίο κώδικα, αναφέρετε προβλήματα ή συνεισφέρετε στο έργο στο GitHub."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explora el código fuente, reporta problemas o contribuye al proyecto en GitHub."
