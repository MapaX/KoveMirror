    "Starts mirroring your screen to the Kove motorcycle dashboard.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet die Bildschirmspiegelung auf das Dashboard des Kove-Motorrads."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκινά τον καθρεφτισμό της οθόνης σας στον πίνακα οργάνων της μοτοσυκλέτας Kove."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia la transmisión de tu pantalla al panel de la motocicleta Kove."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloittaa näytön peilauksen Kove-moottoripyörän mittaristoon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia la trasmissione dello schermo al cruscotto della moto Kove."
          }
        }
      }
    },
