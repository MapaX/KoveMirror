    },
    "To launch navigation on your motorcycle's TFT screen, use the handlebar buttons for your specific model:": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um die Navigation auf dem TFT-Bildschirm deines Motorrads zu starten, verwende die Lenkertasten für dein jeweiliges Modell:"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να εκκινήσετε την πλοήγηση στην οθόνη TFT της μοτοσυκλέτας σας, χρησιμοποιήστε τα κουμπιά τιμονιού του μοντέλου σας:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para iniciar la navegación en la pantalla TFT de tu motocicleta, utiliza los botones del manillar de tu modelo:"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käynnistääksesi navigoinnin moottoripyöräsi TFT-näytöllä, käytä mallikohtaisia ohjaustangon painikkeita:"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per avviare la navigazione sullo schermo TFT della tua moto, usa i pulsanti al manubrio specifici del tuo modello:"
          }
        }
      }
    },
    "Top Black Area:": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oberer schwarzer Bereich:"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επάνω μαύρη περιοχή:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Área negra superior:"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ylempi musta alue:"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Area nera superiore:"
          }
        }
      }
    },
    "Transmits real-time GPS altitude and outdoor temperature to the motorcycle TFT display.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überträgt Echtzeit-GPS-Höhe und Außentemperatur an das TFT-Display des Motorrads."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μεταδίδει το υψόμετρο GPS και την εξωτερική θερμοκρασία σε πραγματικό χρόνο στην οθόνη TFT της μοτοσυκλέτας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transmite la altitud GPS en tiempo real y la temperatura exterior a la pantalla TFT de la motocicleta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähettää reaaliaikaisen GPS-korkeuden ja ulkolämpötilan moottoripyörän TFT-näytölle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasmette l'altitudine GPS e la temperatura esterna in tempo reale al display TFT della moto."
          }
        }
      }
    },
    "TRIP": {
