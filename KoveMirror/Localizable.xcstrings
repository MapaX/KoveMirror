    "Return to Kove Mirror and tap \"Connect BLE\" to establish a fresh pairing handshake.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kehre zu Kove Mirror zurück und tippe auf \"BLE verbinden\", um eine neue Verbindung aufzubauen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιστρέψτε στο Kove Mirror και πατήστε \"Σύνδεση BLE\" για να πραγματοποιήσετε νέα σύζευξη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a Kove Mirror y pulsa \"Conectar BLE\" para establecer una nueva vinculación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palaa Kove Mirroriin ja napauta \"Yhdistä BLE\" muodostaaksesi laiteparin uudelleen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna a Kove Mirror e tocca \"Connetti BLE\" per stabilire una nuova associazione."
          }
        }
      }
    },
