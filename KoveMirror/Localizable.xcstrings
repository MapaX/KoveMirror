    "When MapView is visible and proximity is covered, video streaming seamlessly moves to an offscreen 600x1024 MapView window.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn MapView sichtbar ist und der Näherungssensor abgedeckt wird, wechselt das Videostreaming nahtlos auf ein 600x1024 MapView-Fenster im Hintergrund."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν το MapView είναι ορατό και ο αισθητήρας εγγύτητας καλυφθεί, η ροή βίντεο μεταφέρεται απρόσκοπτα σε ένα παρασκηνιακό παράθυρο MapView 600x1024."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando MapView está visible y se cubre el sensor de proximidad, la transmisión de video pasa de forma transparente a una ventana MapView de 600x1024 fuera de pantalla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun MapView on näkyvissä ja läheisyysanturi peitetään, videolähetys siirtyy saumattomasti taustalla olevaan 600x1024 MapView -ikkunaan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando MapView è visibile e il sensore di prossimità è coperto, lo streaming video passa fluidamente a una finestra MapView fuori schermo 600x1024."
          }
        }
      }
    },
