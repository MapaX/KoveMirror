    "Start Kove Mirror automatically when connecting to your motorcycle.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kove Mirror beim Verbinden mit deinem Motorrad automatisch starten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτόματη εκκίνηση του Kove Mirror κατά τη σύνδεση στη μοτοσυκλέτα σας."
          }
        },
        "es": {
          "stringUnit": {
