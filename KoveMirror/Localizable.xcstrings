    "Kove Mirror": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kove Mirror"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Kove Mirror"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kove Mirror"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kove Mirror"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Kove Mirror"
          }
        }
      }
    },
    "Kove Mirror is %@ free and open source. If the app keeps your motorcycle dashboard running smoothly, you can fuel future updates with a voluntary gas tip!": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kove Mirror ist zu %@ kostenlos und Open Source. Wenn die App dein Motorrad-Dashboard zuverlässig antreibt, kannst du zukünftige Updates mit einem freiwilligen Tankzuschuss unterstützen!"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Kove Mirror είναι %@ δωρεάν και ανοιχτού κώδικα. Εάν η εφαρμογή διατηρεί τον πίνακα οργάνων της μοτοσυκλέτας σας σε άψογη λειτουργία, μπορείτε να υποστηρίξετε μελλοντικές ενημερώσεις με ένα προαιρετικό φιλοδώρημα!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Kove Mirror es %@ gratis y de código abierto. Si la aplicación mantiene el panel de tu moto funcionando a la perfección, puedes apoyar futuras actualizaciones con una propina voluntaria!"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kove Mirror on %@ ilmainen ja avoimen lähdekoodin sovellus. Jos sovellus pitää moottoripyöräsi mittariston toiminnassa, voit tukea tulevia päivityksiä vapaaehtoisella bensarahalla!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Kove Mirror è al %@ gratuito e open source. Se l'app fa funzionare al meglio il cruscotto della tua moto, puoi sostenere i futuri aggiornamenti con una mancia per la benzina!"
          }
        }
      }
    },
    "Kove Model / Screen Resolution": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kove Modell / Bildschirmauflösung"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μοντέλο Kove / Ανάλυση οθόνης"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelo Kove / Resolución de pantalla"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kove-malli / Näytön resoluutio"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modello Kove / Risoluzione schermo"
          }
        }
      }
    },
    "Launches Kove Mirror and readies the screen mirroring connection to your motorcycle.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet Kove Mirror und bereitet die Bildschirmübertragung zu deinem Motorrad vor."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εκκινεί το Kove Mirror και προετοιμάζει τη σύνδεση καθρεφτισμού οθόνης με τη μοτοσυκλέτα σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia Kove Mirror y prepara la conexión de duplicación de pantalla con tu motocicleta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käynnistää Kove Mirrorin ja valmistelee näytön peilausyhteyden moottoripyörääsi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia Kove Mirror e prepara la connessione di mirroring dello schermo alla tua moto."
          }
        }
      }
    },
    "Launches local TCP/UDP socket servers. The motorcycle dashboard connects to your iPhone's hotspot or Wi-Fi to receive the high-fidelity video stream.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet lokale TCP/UDP-Socket-Server. Das Motorrad-Armaturenbrett verbindet sich mit dem Hotspot oder Wi-Fi deines iPhones, um den hochauflösenden Videostream zu empfangen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εκκινεί τοπικούς διακομιστές υποδοχών TCP/UDP. Ο πίνακας οργάνων της μοτοσυκλέτας συνδέεται στο hotspot ή στο Wi-Fi του iPhone σας για να λάβει τη ροή βίντεο υψηλής πιστότητας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia servidores de socket TCP/UDP locales. El panel de la motocicleta se conecta al punto de acceso o Wi-Fi de tu iPhone para recibir la transmisión de video de alta fidelidad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käynnistää paikalliset TCP/UDP-palvelimet. Moottoripyörän mittaristo yhdistää iPhonen yhteyspisteeseen tai Wi-Fi-verkkoon vastaanottaakseen korkealaatuisen kuvasyötteen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia server socket TCP/UDP locali. Il cruscotto della moto si connette all'hotspot o al Wi-Fi del tuo iPhone per ricevere il flusso video ad alta fedeltà."
          }
        }
      }
    },
    "Learn how BLE handles telemetry & Simple navigation, or how to resolve Bluetooth connection conflicts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfahre, wie BLE Telemetrie & einfache Navigation verarbeitet oder wie Bluetooth-Verbindungskonflikte gelöst werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μάθετε πώς το BLE διαχειρίζεται την τηλεμετρία & την απλή πλοήγηση ή πώς να επιλύσετε διενέξεις σύνδεσης Bluetooth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descubre cómo gestiona BLE la telemetría y la navegación simple, o cómo resolver conflictos de conexión Bluetooth."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Opi kuinka BLE hoitaa telemetrian ja yksinkertaisen navigoinnin tai kuinka ratkaista Bluetooth-yhteysongelmia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scopri come il BLE gestisce la telemetria e la navigazione semplice o come risolvere i conflitti Bluetooth."
          }
        }
      }
    },
    "Learn how Bluetooth and Wi-Fi power the features on your motorcycle TFT display.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfahre, wie Bluetooth und Wi-Fi die Funktionen auf deinem Motorrad-TFT-Display antreiben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μάθετε πώς το Bluetooth και το Wi-Fi τροφοδοτούν τις λειτουργίες στην οθόνη TFT της μοτοσυκλέτας σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprende cómo Bluetooth y Wi-Fi hacen funcionar las funciones de la pantalla TFT de tu motocicleta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Opi kuinka Bluetooth ja Wi-Fi ohjaavat moottoripyöräsi TFT-näytön toimintoja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scopri come Bluetooth e Wi-Fi gestiscono le funzionalità sul display TFT della tua moto."
          }
        }
      }
    },
    "Maintains the phone screen aspect ratio instead of stretching to fill the motorcycle display.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behält das Seitenverhältnis des Telefonbildschirms bei, anstatt es für das Motorrad-Display zu strecken."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διατηρεί την αναλογία διαστάσεων της οθόνης του τηλεφώνου αντί να την παραμορφώνει για να γεμίσει την οθόνη της μοτοσυκλέτας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene la relación de aspecto del teléfono en lugar de estirarla para llenar la pantalla de la motocicleta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Säilyttää puhelimen näytön kuvasuhteen venyttämättä kuvaa moottoripyörän näytölle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene le proporzioni dello schermo del telefono invece di allungarle per riempire il display della moto."
          }
        }
      }
    },
