    "Connect your iPhone to the motorcycle's Wi-Fi hotspot in Settings or by scanning the QR code displayed on the bike.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde dein iPhone in den Einstellungen oder durch Scannen des auf dem Motorrad angezeigten QR-Codes mit dem Wi-Fi-Hotspot des Motorrads."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδέστε το iPhone σας στο σημείο πρόσβασης Wi-Fi της μοτοσυκλέτας στις Ρυθμίσεις ή σαρώνοντας τον κωδικό QR της μοτοσυκλέτας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta tu iPhone al punto de acceso Wi-Fi de la motocicleta en Ajustes o escaneando el código QR mostrado en la moto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistä iPhone moottoripyörän Wi-Fi-yhteyspisteeseen Asetuksissa tai skannaamalla pyörän näytöllä näkyvä QR-koodi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connetti il tuo iPhone all'hotspot Wi-Fi della moto nelle Impostazioni o scansionando il codice QR mostrato sulla moto."
          }
        }
      }
    },
