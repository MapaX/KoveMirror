    "Thank you! You've fueled development %lld %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Thank you! You've fueled development %1$lld %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vielen Dank! Du hast die Entwicklung %1$lld %@ unterstützt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ευχαριστούμε! Υποστηρίξατε την ανάπτυξη %1$lld %@."
          }
        },
        "es": {
