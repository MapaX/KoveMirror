    "Turn-by-turn routing for motorcycle TFT display": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbiegehinweise für das Motorrad-TFT-Display"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οδηγίες στροφή προς στροφή για την οθόνη TFT μοτοσυκλέτας"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruta paso a paso para la pantalla TFT de la motocicleta"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käännös käännökseltä -reittiohjeet moottoripyörän TFT-näytölle"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Navigazione curva per curva per display TFT della moto"
          }
        }
      }
    },
    "Turns off screen and disables touch when phone is placed in a pocket or near ear.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet den Bildschirm aus und deaktiviert Touch, wenn das Telefon in die Tasche gesteckt oder ans Ohr gehalten wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απενεργοποιεί την οθόνη και την αφή όταν το τηλέφωνο τοποθετείται στην τσέπη ή κοντά στο αυτί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga la pantalla y deshabilita el táctil cuando el teléfono se guarda en el bolsillo o se acerca al oído."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammuttaa näytön ja kosketuksen, kun puhelin laitetaan taskuun tai lähelle korvaa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spegne lo schermo e disabilita il touch quando il telefono è in tasca o vicino all'orecchio."
          }
        }
      }
    },
    "Type an address, city, or choose a category above to set your destination for motorcycle navigation.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine Adresse oder Stadt ein oder wähle oben eine Kategorie, um dein Ziel für die Motorradnavigation festzulegen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πληκτρολογήστε μια διεύθυνση, πόλη ή επιλέξτε μια κατηγορία παραπάνω για να ορίσετε τον προορισμό πλοήγησης."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe una dirección, ciudad o elige una categoría para establecer el destino de navegación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita osoite, kaupunki tai valitse kategoria asettaaksesi määränpään moottoripyöränavigointiin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Digita un indirizzo, città o scegli una categoria sopra per impostare la destinazione per la navigazione in moto."
          }
        }
      }
    },
    "Uses Apple's hardware-accelerated VideoToolbox engine to compress frames in real-time at the dashboard's native 600x1024 resolution with zero latency.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet Apples hardwarebeschleunigte VideoToolbox-Engine, um Einzelbilder in Echtzeit bei der nativen Auflösung von 600x1024 des Armaturenbretts ohne Latenz zu komprimieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιεί τη μηχανή VideoToolbox με επιτάχυνση υλικού της Apple για τη συμπίεση πλαισίων σε πραγματικό χρόνο στην εγγενή ανάλυση 600x1024 του πίνακα οργάνων με μηδενική καθυστέρηση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliza el motor VideoToolbox acelerado por hardware de Apple para comprimir fotogramas en tiempo real a la resolución nativa de 600x1024 del panel sin latencia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyttää Applen laitteistokiihdytettyä VideoToolbox-moottoria kuvaruutujen reaaliaikaiseen pakkaukseen mittariston 600x1024-natiiviresoluutiolla ilman viivettä."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizza il motore VideoToolbox di Apple accelerato via hardware per comprimere i frame in tempo reale alla risoluzione nativa di 600x1024 senza latenza."
          }
        }
      }
    },
