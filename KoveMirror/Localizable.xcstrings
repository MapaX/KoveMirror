    "Open iOS Bluetooth Settings, find your motorcycle (e.g. CQKY_...), tap the ⓘ info button, and select \"Forget This Device\".": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die iOS-Bluetooth-Einstellungen, suche dein Motorrad (z. B. CQKY_...), tippe auf die ⓘ Info-Taste und wähle \"Dieses Gerät ignorieren\"."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε τις Ρυθμίσεις Bluetooth του iOS, βρείτε τη μοτοσυκλέτα σας (π.χ. CQKY_...), πατήστε το κουμπί πληροφοριών ⓘ και επιλέξτε \"Αγνόηση αυτής της συσκευής\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre los Ajustes de Bluetooth de iOS, busca tu moto (ej. CQKY_...), toca el botón de información ⓘ y selecciona \"Omitir este dispositivo\"."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa iOS:n Bluetooth-asetukset, etsi moottoripyöräsi (esim. CQKY_...), napauta ⓘ-tietopainiketta ja valitse \"Unohda tämä laite\"."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri le Impostazioni Bluetooth di iOS, trova la tua moto (es. CQKY_...), tocca il pulsante info ⓘ e seleziona \"Dimentica questo dispositivo\"."
          }
        }
      }
    },
